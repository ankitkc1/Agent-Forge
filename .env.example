# AgentForge configuration. Copy to .env and adjust; every variable has a safe development default.
# Settings are read by the API, the worker and beat (prefix AGENTFORGE_).

# --- runtime ------------------------------------------------------------------------------------
# development | test | production. Production refuses unsafe settings at startup.
AGENTFORGE_ENV=development
AGENTFORGE_LOG_LEVEL=INFO
AGENTFORGE_DATABASE_URL=postgresql+psycopg://agentforge:agentforge@postgres:5432/agentforge
AGENTFORGE_REDIS_URL=redis://redis:6379/0
AGENTFORGE_ARTIFACT_ROOT=/var/lib/agentforge/artifacts
AGENTFORGE_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8080"]
AGENTFORGE_BUILD_RETENTION_DAYS=30
AGENTFORGE_MAX_REQUIREMENT_CHARS=12000
AGENTFORGE_MAX_ACTIVE_BUILDS=20
# celery (workers; use for every deployment) | inline (runs builds inside the API, development only)
AGENTFORGE_BUILD_DISPATCH=celery

# --- authentication -----------------------------------------------------------------------------
# none (development only) | api_key | trusted_header (identity from an authenticating proxy)
AGENTFORGE_AUTH_MODE=none
# Comma-separated raw keys or sha256:<hex> digests. Prefer digests:
#   python -c "import hashlib,sys; print('sha256:' + hashlib.sha256(sys.argv[1].encode()).hexdigest())" <key>
AGENTFORGE_API_KEYS=
AGENTFORGE_TRUSTED_USER_HEADER=X-Forwarded-Email

# --- artifact signing ---------------------------------------------------------------------------
# Ed25519 seed (base64) or PKCS#8 PEM. Generate with: docker compose run --rm api python -m app.cli generate-signing-key
AGENTFORGE_SIGNING_KEY=
AGENTFORGE_SIGNING_KEY_ID=

# --- sandbox ------------------------------------------------------------------------------------
# process: isolated virtualenv + resource limits (single host) | docker: one container per command
AGENTFORGE_SANDBOX_BACKEND=process
AGENTFORGE_SANDBOX_PYTHON=/opt/agent-runtime/bin/python
AGENTFORGE_SANDBOX_TIMEOUT_SECONDS=300
AGENTFORGE_SANDBOX_MEMORY_MB=2048
AGENTFORGE_SANDBOX_CPU_SECONDS=300
AGENTFORGE_SANDBOX_MAX_PROCESSES=512
# Docker backend only: a dedicated sandbox daemon, never the host socket.
# AGENTFORGE_SANDBOX_DOCKER_HOST=tcp://sandbox-daemon:2376
# AGENTFORGE_SANDBOX_DOCKER_TLS_VERIFY=true
# AGENTFORGE_SANDBOX_DOCKER_CERT_PATH=/run/secrets/sandbox-tls
# AGENTFORGE_SANDBOX_IMAGE=agentforge/sandbox-runtime:1.0.0
# AGENTFORGE_SANDBOX_DOCKER_RUNTIME=runsc

# --- pipeline -----------------------------------------------------------------------------------
AGENTFORGE_REPAIR_MAX_ATTEMPTS=2
AGENTFORGE_ENFORCE_EVAL_TARGETS=true
AGENTFORGE_RUN_BANDIT=true

# --- optional model-assisted features -----------------------------------------------------------
# none | openai | anthropic | ollama. Without a provider the compiler is fully deterministic.
AGENTFORGE_LLM_PROVIDER=none
AGENTFORGE_LLM_MODEL=
AGENTFORGE_LLM_API_KEY=
AGENTFORGE_LLM_BASE_URL=
# Lets the repair agent propose patches to src/ (never tests or evals). Needs worker egress.
AGENTFORGE_REPAIR_USE_LLM=false

# --- compose ------------------------------------------------------------------------------------
AGENTFORGE_WEB_BIND=127.0.0.1
AGENTFORGE_WEB_PORT=8080
AGENTFORGE_WORKER_CONCURRENCY=2
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=agentforge
POSTGRES_DB=agentforge
