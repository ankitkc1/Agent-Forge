"""Runtime configuration (environment variables or .env). Defaults come from agent-spec.yaml."""

from __future__ import annotations

from functools import lru_cache
from pathlib import Path
from typing import Literal

from pydantic import Field, SecretStr
from pydantic_settings import BaseSettings, SettingsConfigDict

DEV_KEYS = {"change-me-dev-key", "change-me-approver-key", ""}


class Settings(BaseSettings):
    model_config = SettingsConfigDict(env_file=".env", env_file_encoding="utf-8", extra="ignore")

    env: Literal["development", "test", "production"] = "development"
    log_level: str = "INFO"
    api_keys: SecretStr = SecretStr("")
    approver_api_keys: SecretStr = SecretStr("")
    request_max_chars: int = Field(default=8000, ge=100, le=100_000)

    model_provider: Literal["openai", "anthropic", "local", "offline"] = {{ model.provider|py }}
    model_name: str = {{ model.model|py }}
    model_base_url: str | None = None
    model_temperature: float = Field(default={{ model.temperature }}, ge=0.0, le=1.0)
    model_max_output_tokens: int = Field(default={{ model.max_output_tokens }}, ge=64, le=32_768)
    model_timeout_seconds: float = Field(default=60.0, ge=1.0, le=600.0)
    openai_api_key: SecretStr | None = None
    anthropic_api_key: SecretStr | None = None

    database_url: str = {{ database_url_default|py }}
    checkpoint_backend: Literal["memory", "sqlite", "postgres"] = {{ checkpoint_backend|py }}
    checkpoint_url: str | None = None
    memory_enabled: bool = {{ memory_enabled|py }}

    tool_backend: Literal["fixture", "http"] = "fixture"
    tool_backend_url: str | None = None
    tool_backend_token: SecretStr | None = None
    fixtures_path: Path = Path("data/fixtures/tools.json")

    knowledge_dir: Path = Path("data/knowledge")
    embeddings: Literal["hashing", "openai", "ollama"] = {{ retrieval.embeddings|py }}
    embedding_model: str | None = None
    embedding_base_url: str | None = None
    embedding_dim: int | None = None
    vector_store: Literal["memory", "pgvector"] = {{ retrieval.store|py }}

    def api_key_set(self) -> set[str]:
        return {key.strip() for key in self.api_keys.get_secret_value().split(",") if key.strip()}

    def approver_key_set(self) -> set[str]:
        raw = self.approver_api_keys.get_secret_value()
        return {key.strip() for key in raw.split(",") if key.strip()}

    def validate_for_production(self) -> None:
        if self.env != "production":
            return
        problems = []
        if not self.api_key_set() or self.api_key_set() & DEV_KEYS:
            problems.append("API_KEYS must be set to non-default values")
        if not self.approver_key_set() or self.approver_key_set() & DEV_KEYS:
            problems.append("APPROVER_API_KEYS must be set to non-default values")
        if self.model_provider == "offline":
            problems.append("MODEL_PROVIDER=offline is for tests and demos only")
        if self.tool_backend == "fixture":
            problems.append("TOOL_BACKEND=fixture serves sample data; configure TOOL_BACKEND=http")
        if self.checkpoint_backend == "memory":
            problems.append("CHECKPOINT_BACKEND=memory loses pending approvals on restart")
        if "change-me" in self.database_url:
            problems.append("DATABASE_URL still uses the development password")
        if problems:
            raise RuntimeError("Unsafe production configuration: " + "; ".join(problems))


@lru_cache
def get_settings() -> Settings:
    return Settings()
